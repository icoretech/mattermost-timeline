{
    "id": "ch.icorete.mattermost-timeline",
    "name": "Mattermost Timeline",
    "description": "Real-time animated timeline of events from external webhooks, displayed in the right-hand sidebar.",
    "version": "2.1.1",
    "homepage_url": "https://github.com/icoretech/mattermost-timeline",
    "support_url": "https://github.com/icoretech/mattermost-timeline/issues",
    "release_notes_url": "https://github.com/icoretech/mattermost-timeline/releases",
    "icon_path": "assets/icon.svg",
    "min_server_version": "7.0.0",
    "server": {
        "executables": {
            "linux-amd64": "server/dist/plugin-linux-amd64",
            "linux-arm64": "server/dist/plugin-linux-arm64",
            "darwin-amd64": "server/dist/plugin-darwin-amd64",
            "darwin-arm64": "server/dist/plugin-darwin-arm64",
            "windows-amd64": "server/dist/plugin-windows-amd64.exe"
        }
    },
    "webapp": {
        "bundle_path": "webapp/dist/main.js"
    },
    "settings_schema": {
        "header": "",
        "footer": "",
        "settings": [
            {
                "key": "WebhookTokens",
                "display_name": "Webhook Tokens",
                "type": "custom",
                "help_text": "",
                "default": "[]",
                "secret": true
            },
            {
                "key": "RequireSignedWebhooks",
                "display_name": "Require Signed Webhooks",
                "type": "custom",
                "help_text": "",
                "default": false
            },
            {
                "key": "WebhookSecret",
                "display_name": "Webhook Secret (legacy)",
                "type": "custom",
                "help_text": "",
                "default": "",
                "secret": true
            },
            {
                "key": "WebhookTools",
                "display_name": "Webhook URLs & Test",
                "type": "custom",
                "help_text": "",
                "default": ""
            },
            {
                "key": "MaxEventsStored",
                "display_name": "Maximum Events Stored",
                "type": "custom",
                "help_text": "",
                "default": "500"
            },
            {
                "key": "MaxEventsDisplayed",
                "display_name": "Maximum Events Displayed",
                "type": "custom",
                "help_text": "",
                "default": "100"
            },
            {
                "key": "TimelineOrder",
                "display_name": "Timeline Order",
                "type": "custom",
                "help_text": "",
                "default": "oldest_first"
            },
            {
                "key": "EnableReactions",
                "display_name": "Enable Reactions",
                "type": "custom",
                "help_text": "",
                "default": true
            }
        ]
    }
}
