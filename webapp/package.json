{
  "name": "mattermost-timeline-webapp",
  "private": true,
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "lint": "biome check --write --assist-enabled=true . && tsc --noEmit",
    "biome:ci": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "1.49.0",
    "mattermost-redux": "11.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@mattermost/client": "11.9.0",
    "@mattermost/types": "11.9.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-redux": "9.3.0",
    "redux": "5.0.1",
    "sass-embedded": "1.105.1",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-css-injected-by-js": "5.0.2",
    "vitest": "5.0.3"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "fsevents@2.3.3": true
  }
}
