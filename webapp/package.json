{
  "name": "mattermost-timeline-webapp",
  "private": true,
  "scripts": {
    "build": "vite build",
    "build:watch": "vite build --watch",
    "lint": "biome check --write --assist-enabled=true . && tsc --noEmit && npm run doctor",
    "biome:ci": "biome ci .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "i18n:check": "vitest run src/i18n.test.ts",
    "doctor": "react-doctor -y"
  },
  "dependencies": {
    "lucide-react": "1.63.0",
    "mattermost-redux": "11.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@formatjs/icu-messageformat-parser": "3.5.22",
    "@mattermost/client": "11.9.0",
    "@mattermost/types": "11.9.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "react": "19.3.1",
    "react-doctor": "0.9.18",
    "react-dom": "19.3.1",
    "react-intl": "12.1.6",
    "react-redux": "9.3.1",
    "redux": "5.0.1",
    "sass-embedded": "1.107.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vite-plugin-css-injected-by-js": "5.0.3",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fsevents@2.3.3": true
  }
}
